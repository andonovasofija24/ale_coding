OPENAI_API_KEY=sk-...
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme
FIRST_ADMIN_NAME=Admin

# Optional: per-student limits (0 = no limit). Admins are never limited.
# RATE_AI_PER_MINUTE=10
# RATE_AI_PER_DAY=300
# RATE_TESTS_PER_MINUTE=20
# Optional: how many submissions the code runner tests at the same time (the rest wait in a queue)
# RUNNER_WORKERS=4
# Optional: passwords of the PostgreSQL sandbox used by PostgreSQL tasks (change them on a real server)
# PG_SANDBOX_SUPERUSER_PASSWORD=...
# PG_SANDBOX_ADMIN_PASSWORD=...

# Optional: sign in with Microsoft (faculty accounts). Register an app in Microsoft Entra ID (Azure) with the
# redirect URI  <PUBLIC_URL>/auth/microsoft/callback  and put its values here.
# MS_CLIENT_ID=...
# MS_CLIENT_SECRET=...
# MS_TENANT_ID=<the faculty's tenant id (GUID)>     # recommended; "organizations" = any work/school account
# MS_ALLOWED_DOMAINS=students.finki.ukim.mk,finki.ukim.mk
# PUBLIC_URL=http://localhost:8000                  # where the backend is reachable from the browser
# FRONTEND_URL=http://localhost:3000                # where the web app is

# --- courses.finki (Moodle) — LTI 1.3 -------------------------------------------------
# Nothing to set here: the platform is registered in the app (Administration → courses.finki (LTI)).
# PUBLIC_URL must be reachable from the browser AND from the Moodle server (Moodle fetches ALE's key at
# <PUBLIC_URL>/lti/jwks), and both should be HTTPS on a real server: Moodle shows ALE in an iframe, and browsers
# only send cookies to a site inside another site's page over HTTPS.

# --- Exams: "allowed networks" check -------------------------------------------------
# Behind a reverse proxy (the bundled nginx /api/, or the faculty's proxy) the backend sees the
# proxy's address; set this to true so it uses the X-Forwarded-For header instead.
# Leave false when the backend port is reachable directly (then the header could be faked).
# TRUST_PROXY_HEADERS=false

# --- Load: an exam with a few hundred students -----------------------------------------
# How many submissions are tested at the same time. More = faster results, but each one uses a CPU core:
# on a server with 8 cores use about 6. Keep SUBMISSION_WORKERS equal to RUNNER_WORKERS.
# RUNNER_WORKERS=4
# SUBMISSION_WORKERS=4
# Test before the exam:  python scripts/loadtest_exam.py --students 200 --admin-password <FIRST_ADMIN_PASSWORD>

# --- E-mail (announcements, grades, deadline reminders) -------------------------------------
# MAIL_MODE=preview      # nothing leaves the server; messages are shown under Admin → Mail (default)
# MAIL_MODE=smtp         # any SMTP server, e.g. the faculty's
# MAIL_FROM=ale@finki.ukim.mk
# MAIL_FROM_NAME=ALE — ФИНКИ
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=ale@finki.ukim.mk
# SMTP_PASSWORD=...
# SMTP_SECURITY=starttls   # starttls | ssl | none
# MAIL_MODE=microsoft    # Microsoft 365 via Graph: uses MS_CLIENT_ID / MS_CLIENT_SECRET / MS_TENANT_ID above;
#                        # the app needs the Mail.Send *application* permission; MAIL_FROM = the mailbox that sends
